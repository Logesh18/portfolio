# ============================================================================
# LOGESH T — AI-POWERED PERSONAL PORTFOLIO ENVIRONMENT CONFIGURATION
# ============================================================================

# Public canonical URL used for Open Graph, canonical links, sitemap.xml & robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private Server-Side Ollama Inference Endpoint (NEVER exposed to browser)
# Local dev default: http://127.0.0.1:11434
# Docker Compose internal network: http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Configurable open-weight model identifier (switchable without code changes)
# Recommended lightweight model: qwen3:1.7b (or qwen2.5:1.5b-instruct / llama3.2:1b)
OLLAMA_MODEL=qwen3:1.7b

# Maximum server-to-model inference timeout in milliseconds before deterministic RAG fallback
OLLAMA_TIMEOUT_MS=12000

# Per-IP sliding-window rate limit for POST /api/assistant
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
